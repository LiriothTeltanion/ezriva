# Ezriva configuration names only. Copy to .env and provide local values.
APP_ENV=development
APP_VERSION=0.1.0
PUBLIC_DEMO_MODE=true
ALLOW_PRIVATE_UPLOADS=false

# Required only for an explicitly authorized live Bedrock fixture run.
AWS_REGION=
BEDROCK_MODEL_ID=
MODEL_MAX_TOKENS=1800
MODEL_MAX_CYCLES=3

# Product safety limits stay below current Bedrock Converse upstream limits.
MAX_IMAGE_BYTES=3670016
MAX_PDF_BYTES=4194304
MAX_PDF_PAGES=3

# Later checklist items; no hosted resources are created by the baseline.
DYNAMODB_TABLE_NAME=
ACTION_TTL_DAYS=7
APPROVAL_TTL_SECONDS=600
OTEL_EXPORT_ENABLED=false
